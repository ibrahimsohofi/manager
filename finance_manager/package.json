{
  "name": "finance_manager",
  "private": true,
  "version": "1.0.0",
  "description": "SOHOFI BRICO finances: expenses, real monthly / yearly profit, break-even (FINANCE_PLAN.md)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\" --names \"finance_api,finance_ui\" --prefix-colors \"green,cyan\"",
    "dev:mock": "concurrently \"cd server && bun run dev:mock\" \"bun run dev:frontend\" --names \"finance_mock,finance_ui\" --prefix-colors \"magenta,cyan\"",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "cd server && bun run dev",
    "build": "vite build --outDir dist",
    "preview": "vite preview",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "test": "cd server && bun run test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.3.2",
    "lucide-react": "^0.471.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.7.1",
    "recharts": "^2.15.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.3.5"
  }
}
