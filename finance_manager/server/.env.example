# finance_manager API settings (FINANCE_PLAN.md §1, §1.1).
# Copy to .env with `bun run setup-env` (never overwrites an existing .env). Shell variables win over this file.

# ---------- Server ----------
PORT=3002
# Loopback only: the finance frontend reaches the API through the Vite /api proxy on the same machine.
# Set HOST=0.0.0.0 only if another device must reach the API directly.
HOST=127.0.0.1
NODE_ENV=development

# ---------- Finance database (read / write) ----------
# Created on first start if missing. Never the sales database (bricojamal) or the catalogue (products_manager).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finance_manager

# ---------- Sales database (read only) ----------
# Empty values fall back to the DB_* values above. SALES_DB_PASSWORD is only read when SALES_DB_USER is set.
# Production: create a user with `GRANT SELECT ON bricojamal.* TO 'finance_ro'@'localhost';`
SALES_DB_HOST=
SALES_DB_PORT=
SALES_DB_USER=
SALES_DB_PASSWORD=
SALES_DB_NAME=bricojamal

# ---------- Other apps ----------
# Catalogue API (stock values + money spent on purchases, read over HTTP) and the sales app (links to the sales history).
PRODUCTS_API_URL=http://localhost:5000
SALES_APP_URL=http://localhost:5174

# ---------- Security ----------
# Comma-separated list of browser origins allowed to call the API. "*" is refused.
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# The finance app locks itself (PIN asked again) after this many minutes without activity.
SESSION_IDLE_MINUTES=15
